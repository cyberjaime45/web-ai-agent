# Web Agent configuration — copy to .env and fill in what you need.
# Every value below is the default; leave a line out (or empty) to keep it.
# Comments go on their own line: text after an empty value becomes the value.

# ── Run ─────────────────────────────────────────────────────────
# Report folder name: reports/<ENVIRONMENT>/
ENVIRONMENT=staging
# Label in the report, the console summary and the LambdaTest dashboard
BUILD_NAME=Web Test Report
# local (Playwright launches a browser) | lambda (LambdaTest grid)
RUNNING_MODE=local

# ── Browser (local mode) ────────────────────────────────────────
# chromium | firefox | webkit
BROWSER=chromium
# false opens a visible, maximized window (Chromium)
HEADLESS=true
# Milliseconds between Playwright operations, for watching a run
SLOW_MO=0
# WIDTHxHEIGHT for headless runs and non-Chromium browsers
VIEWPORT=1920x1080

# ── Device profiles ─────────────────────────────────────────────
# Default profile(s) when neither --profile nor a flow's `profiles:` says: desktop, mobile
PROFILE=desktop
# Playwright device descriptor behind the mobile profile
MOBILE_DEVICE=iPhone 13

# ── LambdaTest (RUNNING_MODE=lambda) ────────────────────────────
LT_USERNAME=
LT_ACCESS_KEY=

# ── AI — Layer 3 (optional) ─────────────────────────────────────
# openai | gemini | anthropic. Empty turns L3 off; when set, LLM_KEY and LLM_MODEL are required.
AI_PROVIDER=
LLM_KEY=
# e.g. claude-opus-5, gpt-4o-mini, gemini-1.5-flash
LLM_MODEL=

# ── Execution behaviour ─────────────────────────────────────────
# Automatic checks after navigation steps: warn (record) | strict (fail on errors) | off
ORACLE=warn
# Run a flow with a failed section once more (pytest); sections that pass then are "passed on retry"
RERUN_FAILED=false
# Dismiss cookie banners and modals before every step (a failed click or fill is always retried once after a dismissal)
DISMISS_BLOCKERS=false
# Let autonomous skills press delete / pay / send controls — disposable environments only
ALLOW_DESTRUCTIVE=false

# ── Evidence and reporting ──────────────────────────────────────
# on-failure keeps a Playwright trace of each failed flow | off
TRACE=on-failure
# Extra comma-separated key substrings to redact from report headers and payloads
REPORT_REDACT=

# ── Flow credentials (<PLACEHOLDER> values in flow files) ───────
# Any <NAME> in a flow reads the variable NAME; names with PASSWORD, SECRET, KEY
# or TOKEN are masked in the console and the report.
# FMS production smoke (tests/fms/production_smoke.md, components/sso_login.md)
FMS_EMAIL=
FMS_PASSWORD=
# Generic names used in the docs' examples
# APP_URL=https://staging.example.com
# APP_EMAIL=
# APP_PASSWORD=

# ── Database integration (optional, app/integrations/database) ──
# Only needed by code that uses the MySQL/MariaDB client; flows do not.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10