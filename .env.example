# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=staging          # staging | production
BASE_URL=                    # base URL for the application under test
LOG_LEVEL=info               # debug | info | warning | error

# ── Execution mode ─────────────────────────────────────────────────────────────
RUNNING_MODE=local           # local | lambda

# ── Browser (local mode) ───────────────────────────────────────────────────────
BROWSER=chromium             # chromium | firefox | webkit
HEADLESS=true                # true | false
SLOW_MO=0                    # milliseconds between actions (useful for debugging)

# ── LambdaTest (lambda mode only) ─────────────────────────────────────────────
LT_USERNAME=                 # your LambdaTest username
LT_ACCESS_KEY=               # your LambdaTest access key

# ── AI resolver (Layer 3 — optional) ──────────────────────────────────────────
OPENAI_API_KEY=              # required to enable Layer 3 AI fallback
OPENAI_MODEL=gpt-4o-mini    # OpenAI model to use for element resolution

# ── Timeouts ──────────────────────────────────────────────────────────────────
NAVIGATION_TIMEOUT=30000     # ms — page navigation timeout
ACTION_TIMEOUT=10000         # ms — element interaction timeout

# ── Reporting ─────────────────────────────────────────────────────────────────
COVERAGE=0                   # 1 to enable coverage reporting
COVERAGE_TARGET=80           # minimum acceptable coverage percentage
THEME_STYLE=system           # system | light | dark

# ── Database (optional — only if using app.integrations.database) ──────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_CHARSET=utf8mb4
# DB_CONNECT_TIMEOUT=10
