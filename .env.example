# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=staging          # staging | production
# Run label: report title + LambdaTest build. Empty → "Web Test Report".
# (keep comments on their own line — an inline comment after an empty value becomes the value)
BUILD_NAME=

# ── Execution mode ─────────────────────────────────────────────────────────────
RUNNING_MODE=local           # local | lambda

# ── Browser (local mode) ───────────────────────────────────────────────────────
BROWSER=chromium             # chromium | firefox | webkit
HEADLESS=true                # true | false
SLOW_MO=0                    # milliseconds between actions (useful for debugging)
VIEWPORT=1920x1080           # WIDTHxHEIGHT (headless, and headed non-Chromium)
DISMISS_BLOCKERS=false       # true to automatically dismiss popups, modals, and cookie banners

# ── LambdaTest (lambda mode only) ─────────────────────────────────────────────
LT_USERNAME=                 # your LambdaTest username
LT_ACCESS_KEY=               # your LambdaTest access key

# ── Flow credentials (resolved from <VAR> placeholders in .md flows) ─────────
FMS_EMAIL=                   # email for flow login steps
FMS_PASSWORD=                # password for flow login steps

# ── AI resolver (Layer 3 — optional) ──────────────────────────────────────────
# Set all three to enable L3. Leave all three empty to disable L3.
AI_PROVIDER=                 # openai | gemini | anthropic
LLM_KEY=                     # API key for the selected provider
LLM_MODEL=                   # model id (e.g. gpt-4o-mini, gemini-1.5-flash, claude-haiku-4-5-20251001)

# ── Reporting ─────────────────────────────────────────────────────────────────
# Timeouts live in each flow's `## Config` (`- timeout: 30000`), not here.
REPORT_REDACT=               # extra sensitive key substrings (comma-separated) masked in report network data

# ── Database (optional — only if using app.integrations.database) ──────────────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_CHARSET=utf8mb4
# DB_CONNECT_TIMEOUT=10
